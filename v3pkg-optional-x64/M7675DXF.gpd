        *rcNameID: =MANUAL_FEED_DISPLAY

    }

}

*Feature: Resolution
{
    *Name: "Resolution"
    *DefaultOption: 600dpi

    *Option: 300dpi
    {
        *Name: "300dpi"

        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *SpotDiameter: 100

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6

            *Cmd: "@PJL SET RESOLUTION = 300<0A>@PJL SET RAS1200MODE = OFF<0A>"
        }

        *% PJL: rawtobr3=38 ?(RESOLUTION = 300)+36 ?(RAS1200MODE = OFF ? 1200 ??); PCL=94 ? *t300R+110 ? &u300D

        *Command: CmdBeginRaster { *Cmd : "<1B>*t300R<1B>&u300D<1B>*r0A<1B>*b0M" }

        *% rawtobr3=106 ? *r0A; ???? NONE *b0M(?? 1030M, brcomp1030 ???)

    }

    *Option: 600dpi
    {
        *Name: "600dpi"

        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *SpotDiameter: 100

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6

            *Cmd: "@PJL SET RESOLUTION = 600<0A>@PJL SET RAS1200MODE = OFF<0A>"
        }

        *% PJL: rawtobr3=39 ?+36 ?; PCL=95 ? *t600R+112 ? &u600D

        *Command: CmdBeginRaster { *Cmd : "<1B>*t600R<1B>&u600D<1B>*r0A<1B>*b0M" }

        *% rawtobr3=106 ? *r0A; ???? NONE *b0M(?? 1030M, brcomp1030 ???)

    }

    *Option: HQ1200
    {
        *Name: "2400x600dpi (HQ1200)"

        *DPI: PAIR(1200, 1200)
        *TextDPI: PAIR(1200, 1200)
        *SpotDiameter: 100

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6

            *Cmd: "@PJL SET RESOLUTION = 1200<0A>@PJL SET PAPERFEEDSPEED=HALF<0A>@PJL SET RAS1200MODE = TRUE<0A>"
        }

        *% PJL: rawtobr3=40 ?(RESOLUTION = 1200\nPAPERFEEDSPEED=HALF ???)+34 ?(RAS1200MODE = TRUE); ????? capability_matrix ?8.5(???? 1200dpi, MEDIUM ??); PCL=97 ? *t1200R+113 ? &u1200D

        *Command: CmdBeginRaster { *Cmd : "<1B>*t1200R<1B>&u1200D<1B>*r0A<1B>*b0M" }

        *% rawtobr3=106 ? *r0A; ???? NONE *b0M(?? 1030M, brcomp1030 ???)

    }

}

